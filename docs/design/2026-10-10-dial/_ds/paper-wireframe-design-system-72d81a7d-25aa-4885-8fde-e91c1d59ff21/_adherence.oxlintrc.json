{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/collections/**",
              "components/controls/**",
              "components/frame/**",
              "components/icon/**",
              "components/media/**",
              "components/surfaces/**",
              "components/text/**",
              "ui_kits/mobile-flows/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|h|open|gutter|handle|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: children, h, open, gutter, handle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|w|h|full|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, w, h, full, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|soft)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|radius|pad|inset|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, radius, pad, inset, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Carousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|index|onChange|h|radius|variant|style|key|ref|className|style|children)$/]",
        "message": "<Carousel> doesn't accept that prop. Declared props: count, index, onChange, h, radius, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Carousel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wash|inked|solid)$/]",
        "message": "<Carousel> variant must be one of 'wash' | 'inked' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|size|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<CheckCircle> doesn't accept that prop. Declared props: checked, size, onChange, disabled, style."
