        "selector": "JSXOpeningElement[name.name='ChoiceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onSelect|marker|label|labelW|h|style|key|ref|className|style|children)$/]",
        "message": "<ChoiceRow> doesn't accept that prop. Declared props: selected, onSelect, marker, label, labelW, h, style."
